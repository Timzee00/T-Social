# First-party app configuration. Never prefix secrets with VITE_.
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=mysql://user:password@localhost:3306/t_social
SESSION_SECRET=
CRON_SECRET=
PORT=3000
# Leave blank unless your trusted reverse proxy overwrites this header.
TRUSTED_PROXY_IP_HEADER=

# Enable only the providers registered for this application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=

# SMS verification uses Twilio Verify. Configure its fraud/geo controls too.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_DAILY_LIMIT=100

# Private S3-compatible bucket. AWS credentials can alternatively come from IAM.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# FFmpeg/FFprobe are required for video uploads.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Payments are OFF until a provider, identity-review process and funded budgets are ready.
# sk_test_ keys only simulate money; no user deposits or coin-to-cash conversion.
WALLET_CASH_ENABLED=false
PAYSTACK_SECRET_KEY=
# Comma-separated user IDs; each must also have admin role. Moderators are not wallet operators by default.
WALLET_OPERATOR_IDS=

# Optional LibreTranslate-compatible base URL. Selected messages leave the app only on request.
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
