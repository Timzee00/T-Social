{
  "name": "t-social",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --packages=external --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b && tsc -p tsconfig.tests.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.103.2",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "jose": "6.1.3",
    "lucide-react": "0.562.0",
    "mysql2": "3.24.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.4",
    "sharp": "0.35.5",
    "sonner": "2.0.7",
    "superjson": "2.2.6",
    "tailwind-merge": "3.4.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@hono/vite-dev-server": "0.19.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.27.2"
    }
  }
}
